{
  "manifest_version": 3,
  "name": "Slip Mate",
  "version": "3.1.0",
  "minimum_chrome_version": "102",
  "description": "Crie e compartilhe links de apostas Bet365, inclusive sem login.",
  "permissions": ["activeTab", "clipboardWrite", "storage"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bet365.bet.br/*",
        "https://www.bet365.com/*"
      ],
      "js": ["bet365-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bet365.bet.br/*",
        "https://www.bet365.com/*"
      ],
      "css": ["slip-mate-page.css"],
      "js": [
        "url-builder.js",
        "bet365-parser.js",
        "slip-store.js",
        "slip-ui.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  }
}
